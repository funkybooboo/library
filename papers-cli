#!/usr/bin/env -S uv run --script
# Download and open the academic papers listed in papers.yml.
# deps (pyyaml, requests) are declared in the inline script-metadata block
# below; uv provisions them automatically the first time you run this.
# Run directly: ./papers-cli <command> ...

# /// script
# requires-python = ">=3.12"
# dependencies = [
#     "pyyaml>=6.0.2",
#     "requests>=2.32.3",
# ]
# ///

import argparse
import concurrent.futures
import os
import re
import time
import webbrowser
import yaml
import requests

PAPERS_FILE = "papers.yml"
DOWNLOAD_DIR = "papers"

USER_AGENT = "Mozilla/5.0 (Windows NT 10.0; rv:112.0) Gecko/20100101 Firefox/112.0"
PDF_HEADERS = {"User-Agent": USER_AGENT, "Accept": "application/pdf,*/*;q=0.8"}


def sanitize_filename(s):
    r"""Safe filename: spaces -> underscores, drop everything non [-\w.]."""
    return re.sub(r'(?u)[^-\w.]', '', s.strip().replace(" ", "_"))


def flatten_with_topics(papers):
    """Flatten papers + related into one list; related inherit the parent's
    first topic (used to organize papers/<topic>/)."""
    flat = []
    for paper in papers or []:
        main = paper.copy()
        related = main.pop("related", None)
        topics = main.get("topics") or []
        flat.append(main)
        for r in related or []:
            rc = r.copy()
            rc["parent_title"] = paper.get("title")
            rc["topics"] = topics
            flat.append(rc)
    return flat


# ---- download --------------------------------------------------------------

def fetch_pdf(link, timeout=30):
    """GET the PDF with browser headers + a referer fallback (link-as-referer,
    then google-as-referer) so hosts that block hotlinking still work. Raises
    RuntimeError on failure."""
    last = "unknown"
    for referer in (link, "https://www.google.com/"):
        try:
            resp = requests.get(link, headers={**PDF_HEADERS, "Referer": referer},
                                timeout=timeout, stream=True)
            if resp.ok:
                return resp.content
            last = f"HTTP {resp.status_code}"
        except requests.RequestException as e:
            last = f"{type(e).__name__}: {e}"
    raise RuntimeError(last)


def _is_pdf(data):
    return data[:4] == b'%PDF'


def download_one(paper):
    """Download one paper dict -> papers/<topic>/<title>.pdf. Skip if present.
    Returns (topic_slug, title_slug, title, link, status, dest, reason) where
    status is ok | skip | warn | fail."""
    title = paper.get("title", "untitled")
    link = paper.get("link")
    if not link:
        return ("", "", title, "", "fail", "", "no link")
    topic_slug = sanitize_filename((paper.get("topics") or ["Uncategorized"])[0])
    title_slug = sanitize_filename(title)
    topic_dir = os.path.join(DOWNLOAD_DIR, topic_slug)
    os.makedirs(topic_dir, exist_ok=True)
    dest = os.path.join(topic_dir, title_slug + ".pdf")
    if os.path.exists(dest):
        return (topic_slug, title_slug, title, link, "skip", dest, "already downloaded")
    try:
        data = fetch_pdf(link)
    except Exception as e:
        return (topic_slug, title_slug, title, link, "fail", dest, str(e))
    if not _is_pdf(data):
        return (topic_slug, title_slug, title, link, "warn", dest,
                "response was not a PDF (likely an HTML login/interstitial page)")
    with open(dest, "wb") as f:
        f.write(data)
    return (topic_slug, title_slug, title, link, "ok", dest, "")


def download_all(jobs=6):
    """Bulk-download every PDF in papers.yml into papers/<topic>/<title>.pdf.
    Dedupes by link, skips files already on disk, writes papers/index.md and
    papers/failed.md. Resumable (re-running is cheap)."""
    with open(PAPERS_FILE) as f:
        flat = flatten_with_topics(yaml.safe_load(f))
    seen, queue = set(), []
    for p in flat:
        link = p.get("link")
        if not link or link in seen:
            continue
        seen.add(link)
        queue.append(p)
    os.makedirs(DOWNLOAD_DIR, exist_ok=True)
    total = len(queue)
    print(f"Downloading {total} papers into {DOWNLOAD_DIR}/<topic>/ ({jobs} parallel)...")
    results = []
    markers = {"ok": "OK  ", "skip": "skip", "warn": "WARN", "fail": "FAIL"}
    with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as ex:
        futs = {ex.submit(download_one, p): p for p in queue}
        for i, fut in enumerate(concurrent.futures.as_completed(futs), 1):
            res = fut.result()
            results.append(res)
            topic_slug, title_slug, title, link, status, dest, reason = res
            print(f"[{i}/{total}] {markers[status]} {title}")
            if reason and status in ("warn", "fail"):
                print(f"        -> {reason}")
    _write_index(results)
    n = lambda s: sum(1 for r in results if r[4] == s)
    print(f"\nDone: {n('ok')} downloaded, {n('skip')} already present, "
          f"{n('warn')} not-PDF, {n('fail')} failed.")
    print(f"Index: {DOWNLOAD_DIR}/index.md   Failures: {DOWNLOAD_DIR}/failed.md")


def _write_index(results):
    successes = sorted((r for r in results if r[4] in ("ok", "skip")),
                       key=lambda r: (r[0], r[1]))
    with open(os.path.join(DOWNLOAD_DIR, "index.md"), "w") as f:
        f.write("# Downloaded Papers\n\n")
        current = ""
        for topic_slug, title_slug, title, link, status, dest, reason in successes:
            if topic_slug != current:
                if current:
                    f.write("\n")
                f.write(f"## {topic_slug}\n\n")
                current = topic_slug
            f.write(f"- [{title}]({os.path.relpath(dest, DOWNLOAD_DIR)})\n")
    with open(os.path.join(DOWNLOAD_DIR, "failed.md"), "w") as f:
        f.write("# Failed Downloads (manual)\n\n")
        failures = [r for r in results if r[4] in ("warn", "fail")]
        if not failures:
            f.write("None -- every download succeeded.\n")
        for topic_slug, title_slug, title, link, status, dest, reason in failures:
            f.write(f"- **{title}** ({status})\n")
            f.write(f"  - Category: `{topic_slug}`\n")
            f.write(f"  - URL: <{link}>\n")
            f.write(f"  - Reason: {reason}\n\n")


# ---- open ------------------------------------------------------------------

def _failed_urls(failed_path):
    """Parse papers/failed.md -> list of (title, url) pairs."""
    if not os.path.exists(failed_path):
        return []
    titles = []
    for line in open(failed_path):
        m = re.match(r"^- \*\*(.+?)\*\* \((\w+)\)", line)
        if m:
            titles.append(m.group(1))
            continue
        m = re.match(r"^\s*- URL: <(.+?)>", line)
        if m:
            titles.append(m.group(1))
    return list(zip(titles[0::2], titles[1::2]))


def _all_links():
    """Every (title, link) from papers.yml, flattened and deduped."""
    with open(PAPERS_FILE) as f:
        flat = flatten_with_topics(yaml.safe_load(f))
    seen, pairs = set(), []
    for p in flat:
        link = p.get("link")
        if not link or link in seen:
            continue
        seen.add(link)
        pairs.append((p.get("title", "untitled"), link))
    return pairs


def _open_urls(pairs, batch, pause, dry_run, label):
    if not pairs:
        print(f"No {label} to open.")
        return
    print(f"Opening {len(pairs)} {label}{'s' if len(pairs)!=1 else ''} in your browser...")
    if dry_run:
        for t, u in pairs:
            print(f"  [dry-run] {t}  ->  {u}")
        return
    opened = 0
    for i, (title, url) in enumerate(pairs, 1):
        print(f"  [{i}/{len(pairs)}] {title}")
        try:
            webbrowser.open(url, new=1, autoraise=True)
            opened += 1
        except Exception as e:
            print(f"    -> couldn't open: {e}")
        if i % batch == 0 and i < len(pairs):
            print(f"    (batch {i // batch} opened; pausing {pause}s...)")
            time.sleep(pause)
    print(f"\nOpened {opened} URLs.")


def _iter_pdfs(root):
    for dirpath, _dirs, files in os.walk(root):
        for name in sorted(files):
            if name.lower().endswith(".pdf"):
                yield os.path.join(dirpath, name)


def open_target(target, failed_path=None, batch=8, pause=1.5, dry_run=False, topic=None):
    """
    open failed     -> papers/failed.md URLs in your browser (batched; the way
                       to get ACM/Cloudflare-gated papers a CLI can't fetch)
    open all         -> every paper link URL from papers.yml (batched)
    open downloaded  -> the papers/ folder (or one --topic subdir) in your file
                       manager
    """
    if target == "failed":
        path = failed_path or os.path.join(DOWNLOAD_DIR, "failed.md")
        pairs = _failed_urls(path)
        if not pairs:
            print(f"No failed URLs recorded in {path}.")
            print("Run './papers-cli download' first to generate it.")
            return
        _open_urls(pairs, batch, pause, dry_run, "failed-download URL")

    elif target == "all":
        pairs = _all_links()
        if not pairs:
            print(f"No links found in {PAPERS_FILE}.")
            return
        _open_urls(pairs, batch, pause, dry_run, "paper URL")

    elif target == "downloaded":
        if not os.path.isdir(DOWNLOAD_DIR):
            print(f"{DOWNLOAD_DIR}/ not found -- run './papers-cli download' first.")
            return
        target_dir = os.path.join(DOWNLOAD_DIR, topic) if topic else DOWNLOAD_DIR
        if not os.path.isdir(target_dir):
            print(f"{target_dir} not found.")
            return
        count = sum(1 for _ in _iter_pdfs(target_dir))
        if dry_run:
            print(f"[dry-run] would open {target_dir} ({count} PDF{'s' if count!=1 else ''} inside)")
            return
        print(f"Opening {target_dir} ({count} PDF{'s' if count!=1 else ''} inside) in your file manager...")
        webbrowser.open(f"file://{os.path.abspath(target_dir)}")
        print("To open a single PDF: xdg-open papers/<topic>/<title>.pdf")


# ---- main ------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="papers-cli",
        description="Download and open the academic papers in papers.yml")
    sub = parser.add_subparsers(dest="command", help="Sub-commands")

    pd = sub.add_parser("download",
                        help="Bulk-download every PDF into papers/<topic>/<title>.pdf")
    pd.add_argument("--jobs", "-j", type=int, default=6,
                    help="Parallel workers (default: 6)")

    po = sub.add_parser("open",
                        help="open {failed,all,downloaded} -- launch in your "
                             "browser/file manager")
    po.add_argument("target", nargs="?", default="failed",
                    choices=["failed", "all", "downloaded"],
                    help="'failed' (default) opens failed.md URLs in your browser; "
                         "'all' opens every paper link URL from papers.yml; "
                         "'downloaded' opens the papers/ folder in your file manager")
    po.add_argument("--file", default=None,
                    help=f"Path to a failed.md (only with 'open failed'; default: {DOWNLOAD_DIR}/failed.md)")
    po.add_argument("--topic", default=None,
                    help="With 'open downloaded', open just this topic subdir")
    po.add_argument("--batch", type=int, default=8,
                    help="Open this many tabs per batch, then pause briefly (default: 8)")
    po.add_argument("--pause", type=float, default=1.5,
                    help="Seconds to pause between batches (default: 1.5)")
    po.add_argument("--dry-run", action="store_true",
                    help="Just list what would be opened, don't launch anything")

    args = parser.parse_args()

    if args.command == "download":
        download_all(args.jobs)
    elif args.command == "open":
        open_target(args.target, args.file, args.batch, args.pause, args.dry_run, args.topic)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()